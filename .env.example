# Copy to .env and fill in. Comments only on their own lines (systemd EnvironmentFile does not strip trailing "# ...").

# Telegram application credentials from https://my.telegram.org
API_ID=
API_HASH=
# Telethon session file name (without .session). The file is created on first login; never commit it.
SESSION_NAME=stenabot_session

# Chat where news are posted (numeric id; for a channel it starts with -100)
TARGET_CHAT_ID=
# Your numeric Telegram id: only this account can control the bot (find it via @userinfobot)
OWNER_ID=

# PostgreSQL (the database user needs rights to create tables in DB_SCHEMA)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stenabot
DB_USER=stenabot
DB_PASSWORD=
DB_SCHEMA=stenabot

# Optional, can also be changed from the chat (/lang, /mode, /digest, /quiet, /tz)
# LANGUAGE=en
# DELIVERY_MODE=instant
# DIGEST_HOURS=3
# QUIET_HOURS=23:00-08:00
# TIMEZONE=UTC
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# OpenAI-compatible embeddings server (for example llama.cpp with nomic-embed-text)
EMBEDDINGS_URL=http://localhost:8081/v1/embeddings
EMBEDDINGS_MODEL=nomic-embed-text

# Optional: failure notifications from systemd (see deploy/README.md). A separate ordinary bot from @BotFather,
# started once from the owner account.
# NOTIFY_BOT_TOKEN=

# STENABOT_DOTENV=0 - do not read this file on import (tests set it so real values never leak into them)
